FROM node:20-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm@10.23.0
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json tsconfig.base.json tsconfig.json ./
COPY artifacts/rudra-fiber/package.json ./artifacts/rudra-fiber/
COPY lib ./lib
RUN pnpm install --frozen-lockfile
COPY artifacts/rudra-fiber ./artifacts/rudra-fiber
RUN pnpm --filter @workspace/rudra-fiber run build

FROM nginx:alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/artifacts/rudra-fiber/dist/public /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
